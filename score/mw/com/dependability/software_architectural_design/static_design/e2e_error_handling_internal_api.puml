@startuml e2e_error_handling_internal_api
title "E2E Error Handling — Binding-Agnostic Public API (data model)"

namespace e2e_error_handling {

  enum E2ECheckStatus <<enumeration>> {
    Ok
    OkSomeLost
    Repeated
    WrongSequence
    Error
    NoNewData
  }

  note right of E2ECheckStatus : Full protocol status set (E2E spec §4.2); never reduced to binary by default (R2,R3); Error covers CRC/Data-ID mismatch incl. masquerading (R6)

  enum E2EStateMachineState <<enumeration>> {
    Deinit
    NoData
    Init
    Valid
    Invalid
  }

  note right of E2EStateMachineState : Optional state machine (E2E spec §4.3); NoData/Init warm-up kept distinct from Invalid (R5)

  class E2EResult <<struct>> {
    + checkStatus : E2ECheckStatus
    + smState : E2EStateMachineState
  }

  class E2EConfiguration <<struct>> {
    + maxDeltaCounter : uint16_t
    + windowSizeInit : uint8_t
    + windowSizeValid : uint8_t
    + windowSizeInvalid : uint8_t
    + minOkStateInit : uint8_t
    + maxErrorStateInit : uint8_t
    + disableEndToEndStateMachine : bool
  }

  interface "E2EErrorHandling" as E2EErrorHandling <<interface>> {
    {abstract} GetE2EResult() : E2EResult
  }

  interface "E2ELibraryInterface" as E2ELibraryInterface <<interface>> {
    {abstract} E2E_PxxCheck(sample) : E2ECheckStatus
    {abstract} E2E_SMCheck(checkStatus) : E2EStateMachineState
  }

  note right of E2ELibraryInterface : one library exposes both the per-sample check (E2E spec §4.1) and the optional state machine (§4.3) — not two separate components

  E2EErrorHandling ..> E2EResult : returns per sample (R1)
  E2EErrorHandling ..> E2ELibraryInterface : implemented via
  E2EResult *-- E2ECheckStatus
  E2EResult o-- "0..1" E2EStateMachineState
  E2EErrorHandling ..> E2EConfiguration : configured by (R4)
}

@enduml
